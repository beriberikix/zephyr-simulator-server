# Domain and TLS settings
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Backend image source (published by GitHub Actions)
BACKEND_IMAGE_REPO=ghcr.io/beriberikix/zephyr-simulator-server-backend
BACKEND_IMAGE_TAG=latest

# Backend runtime settings
PORT=8080
BASE_IMAGE_URL=zephyr-emulator:latest
RUNTIME_NAME=runsc
DATA_DIR=/data/pb_data

# Optional backend settings
STATE_FILE_PATH=/data/state.json
PCAP_BASE_DIR=/data/pcaps
PCAP_RETENTION=24h
PCAP_PRUNER_INTERVAL=1h
